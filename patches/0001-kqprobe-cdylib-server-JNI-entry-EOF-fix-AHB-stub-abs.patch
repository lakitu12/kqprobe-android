+/* PATCH(nous-hermes): a leading '@' in a unix socket path selects the abstract
+ * namespace instead of a filesystem pathname (linux only). Applied on both the
+ * client (Tube::new) and server (Listener::bind) side, so "@kumquat-gpu-0"
+ * works symmetrically. */
+fn unix_addr_from_bytes(bytes: &[u8]) -> rustix::io::Result<SocketAddrUnix> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        if let Some(name) = bytes.strip_prefix(b"@") {
+            return SocketAddrUnix::new_abstract_name(name);
+        }
+    }
+    let path = {
+        use std::os::unix::ffi::OsStrExt;
+        std::path::Path::new(std::ffi::OsStr::from_bytes(bytes))
+    };
+    SocketAddrUnix::new(path)
+}
