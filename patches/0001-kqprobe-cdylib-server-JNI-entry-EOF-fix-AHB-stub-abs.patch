@@ -0,0 +1,70 @@
+// lib.rs — kumquat server as Android cdylib (app-domain GPU broker)
+// JNI: Java_me_lakitu_kqprobe_MainActivity_nativeStart(socketPath, statusPath)
+mod kumquat;
+mod kumquat_gpu;
+
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::os::raw::c_void;
+
+use jni::objects::JString;
+use jni::sys::jint;
+use jni::JNIEnv;
+
+fn log_line(path: &str, msg: &str) {
+    if let Ok(mut f) = OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(f, "{}", msg);
+    }
+}
+
+/// Start the kumquat virtio-gpu server on a background thread.
+/// Returns 0 once the thread is spawned; real status goes to statusPath.
+#[no_mangle]
+pub extern "system" fn Java_me_lakitu_kqprobe_MainActivity_nativeStart<'local>(
+    mut env: JNIEnv<'local>,
+    _class: jni::objects::JClass<'local>,
+    socket_path: JString<'local>,
+    status_path: JString<'local>,
+) -> jint {
+    let path: String = match env.get_string(&socket_path) {
+        Ok(s) => s.into(),
+        Err(_) => return -1,
+    };
+    let status: String = match env.get_string(&status_path) {
+        Ok(s) => s.into(),
+        Err(_) => return -2,
+    };
+    log_line(&status, &format!("nativeStart called, path={path}"));
+    std::thread::spawn(move || {
+        log_line(&status, "starting");
+        // App domain cannot open root-only /dev/udmabuf (crw-------); the backend
+        // auto-enables VulkanAllocateHostVisibleAsUdmabuf on 6.6+udmabuf and then
+        // GFXSTREAM_FATALs in UdmabufCreator::init(). Force it disabled for now
+        // (blob memory falls back to memfd; revisit with a udmabuf shim later).
+        let mut kumquat = match kumquat::KumquatBuilder::new()
+            .set_capset_names("gfxstream-vulkan".to_string())
+            .set_gpu_socket(Some(path.clone()))
+            .set_renderer_features(
+                // format: "Name:value" pairs split on ",;" (FeatureSet::processFeatureString)
+                // udmabuf: app domain can't open root-only /dev/udmabuf (fatal abort).
+                // ExternalBlob MUST stay on (blob-resources is the gfxstream memory backbone;
+                // disabling it => guest "VirtGpuDevice does not support blob-resources").
+                "VulkanAllocateHostVisibleAsUdmabuf:disabled".to_string(),
+            )
+            .build()
+        {
+            Ok(k) => k,
+            Err(e) => {
+                log_line(&status, &format!("build FAILED: {e:?}"));
+                return;
+            }
+        };
+        log_line(&status, &format!("listening on {path}"));
+        loop {
+            if let Err(e) = kumquat.run() {
+                log_line(&status, &format!("run error: {e:?}"));
+            }
+        }
+    });
+    0
+}
